#!/bin/bash

# omarchy-egpu — the engine. omarchy-egpu <module> <verb> [args]
#
#   status [--json|--human]     one status document (plan-engine.md §5)
#   status watch                JSON-lines stream + $XDG_RUNTIME_DIR/omarchy-egpu/status.json
#   health [--json|--human]     setup/health rows (§9)
#   steam <verb> [args]         per-game "Run on eGPU" in Steam (§8; lib/steam/steam.sh)
#   display <verb> [args]       eGPU monitors, display.policy, the toggle file (§7; lib/display.sh)
#   device connect [opts]       bolt → PCI → driver → verify (§6.1; lib/device.sh)
#   connect [opts]              the same
#   device eject [--close]      monitors off → holders → PCI remove → unload if free (§6.3)
#   device rescan               bring an ejected card back without replugging (§6.4)
#   device holders              who holds or uses the card, classified (§6.2)
#
# JSON on stdout, prose on stderr. Exit codes (§1.1): 0 ok, 1 refused or
# failed ({"error":...} on stdout), 3 busy; 126/127 from pkexec pass through.
# The panel and the notch run only this; every decision lives here.
#
# Later phases add: config, health fix/bundle. bin/egpu-run is the offload wrapper (§7.4).

set -uo pipefail

EGPU_LIB="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../lib" && pwd)"
export EGPU_LIB

usage() {
  cat >&2 <<'USAGE'
usage: omarchy-egpu <module> <verb> [args]
  status [--json|--human]
  status watch
  health [--json|--human]
  steam roots | accounts [--root R] | list [--account A] [--root R] | status
  steam set <appid> on|off [--nvapi on|off] [--adopt] [--account A] [--queue]
  steam set-all on|off [--only-stale] [--account A] [--queue]
  steam apply [--close] [--relaunch] | close | restore <accountid> <backup>
  device connect [--timeout S] [--enroll] [--quiet]   (also: connect ...)
  device eject [--close] [--quiet] | rescan [--timeout S] [--quiet] | holders
  display list | off | render | apply
  display enable|disable|move-workspaces <monitor>
  display set <monitor> '{"mode":…,"position":"left|right|above|below|x,y","scale":…,"mirror":bool,"vrr":bool}'
  display policy [get] | policy set igpu|egpu-hdmi
USAGE
}

module=${1:-}
[[ $# -gt 0 ]] && shift

case $module in
  status)
    # shellcheck source=lib/status.sh
    source "$EGPU_LIB/status.sh"
    status_main "$@"
    ;;
  health)
    # shellcheck source=lib/health.sh
    source "$EGPU_LIB/health.sh"
    health_main "$@"
    ;;
  steam)
    # shellcheck source=lib/steam/steam.sh
    source "$EGPU_LIB/steam/steam.sh"
    steam_main "$@"
    ;;
  display)
    # shellcheck source=lib/display.sh
    source "$EGPU_LIB/display.sh"
    display_main "$@"
    ;;
  device)
    # shellcheck source=lib/device.sh
    source "$EGPU_LIB/device.sh"
    device_main "$@"
    ;;
  connect)
    # shellcheck source=lib/device.sh
    source "$EGPU_LIB/device.sh"
    device_main connect "$@"
    ;;
  -h | --help | help)
    usage
    exit 0
    ;;
  *)
    usage
    printf '{"error":"usage"}\n'
    exit 1
    ;;
esac
