#!/bin/bash
# Fake steam. `-shutdown` ends the fake Steam processes (pgrep.txt) unless
# $EGPU_FAKE_DIR/steam-ignores-shutdown exists; anything else starts it.
printf 'steam %s\n' "$*" >>"${EGPU_FAKE_LOG:-/dev/null}"
f="$EGPU_FAKE_DIR/pgrep.txt"
case "$*" in
  -shutdown)
    [[ -e $EGPU_FAKE_DIR/steam-ignores-shutdown || ! -e $f ]] && exit 0
    grep -vE '^(steam|steamwebhelper) ' "$f" >"$f.tmp"
    mv -f "$f.tmp" "$f"
    # Real stand-in processes (tests/eject.sh) quit as Steam's children would.
    if [[ -r $EGPU_FAKE_DIR/steam-pids ]]; then
      while IFS= read -r p; do [[ -n $p ]] && kill -TERM "$p" 2>/dev/null; done <"$EGPU_FAKE_DIR/steam-pids"
    fi
    ;;
  *)
    # Started, with or without options (the panel passes -cef-disable-gpu).
    printf 'steam 4242\nsteamwebhelper 4243\n' >>"$f"
    ;;
esac
exit 0
